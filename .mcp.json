{
  "mcpServers": {
    "angular": {
      "command": "npx",
      "args": ["ng", "mcp", "--read-only"]
    },
    "spartan": {
      "command": "npx",
      "args": ["-y", "@spartan-ng/mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  }
}
