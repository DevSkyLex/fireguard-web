{
  "name": "fireguard-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --configuration=coverage",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf",
    "start:fr": "ng serve --configuration=fr",
    "start:es": "ng serve --configuration=es",
    "e2e:install": "playwright install",
    "e2e:test": "playwright test --config=tests/e2e/playwright.config.ts",
    "e2e:chromium": "playwright test --config=tests/e2e/playwright.config.ts --project=chromium",
    "e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --project=chromium --headed",
    "e2e:ui": "playwright test --config=tests/e2e/playwright.config.ts --ui",
    "e2e:debug": "playwright test --config=tests/e2e/playwright.config.ts --project=chromium --debug",
    "e2e:report": "playwright show-report",
    "e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore && npm run lint:type-aware && npm run lint:architecture",
    "lint:type-aware": "npm run lint:type-aware:check && oxlint --type-aware -c .oxlintrc.type-aware.json . --tsconfig tsconfig.json --ignore-path .gitignore",
    "lint:type-aware:check": "node tools/lint/check-type-aware.mjs",
    "lint:architecture": "npm run test:architecture",
    "lint:fix": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore --fix && oxlint --type-aware -c .oxlintrc.type-aware.json . --tsconfig tsconfig.json --ignore-path .gitignore --fix",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "review:check": "node .codex/scripts/review-check.mjs",
    "docs:check": "node .codex/scripts/check-docblocks.mjs",
    "docs:fix": "node .codex/scripts/check-docblocks.mjs --fix",
    "docs:test": "node --test .codex/scripts/check-docblocks.test.mjs",
    "e2e:harness": "playwright test --config=tests/e2e/harness/playwright.config.ts",
    "e2e:localized": "playwright test --config=tests/e2e/localized/playwright.config.ts",
    "e2e:ssr": "playwright test --config=tests/e2e/ssr/playwright.config.ts",
    "e2e:ssr:build": "node tests/e2e/ssr/build.cjs",
    "quality": "npm run format:check && npm run docs:check && npm run lint && npm run test:ci && npm run build",
    "serve:ssr:fireguard-web": "node dist/fireguard-web/server/server.mjs",
    "e2e": "ng e2e",
    "test:architecture": "npm run test:architecture:typecheck && vitest run --config tests/architecture/vitest.config.ts",
    "test:architecture:typecheck": "tsc -p tests/architecture/tsconfig.json --noEmit",
    "test:contracts": "npm run test:contracts:typecheck && vitest run --config tests/contracts/vitest.config.ts",
    "test:contracts:typecheck": "tsc -p tests/contracts/tsconfig.json --noEmit",
    "test:contracts:sync": "node tests/contracts/sync-openapi.mjs",
    "test:contracts:drift": "node tests/contracts/sync-openapi.mjs ../fireguard-api/openapi.json --check",
    "e2e:live-api": "playwright test --config=tests/e2e/live-api/playwright.config.ts"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/localize": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/flag-icons": "^34.0.0",
    "@ng-icons/lucide": "^34.0.0",
    "@ng-icons/svgl": "^34.0.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@signality/core": "^0.4.0",
    "@spartan-ng/brain": "1.4.1",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "@types/three": "^0.185.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@angular/language-server": "22.2.1",
    "@playwright/test": "1.62.1",
    "@spartan-ng/cli": "1.4.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-ng-schematics": "^22.0.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@spartan-ng/cli": {
      "ts-morph": "27.0.2"
    },
    "nx": {
      "axios": "1.20.0",
      "brace-expansion": "5.0.12",
      "smol-toml": "1.9.0"
    },
    "oxfmt": {
      "tinypool": "2.1.2"
    }
  },
  "packageManager": "npm@11.16.0"
}
