{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2023",
    "module": "preserve",
    "types": ["node", "vitest/globals", "@angular/localize"],
    "paths": {
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],
      "@core": ["./src/app/core"],
      "@core/*": ["./src/app/core/*"],
      "@shared": ["./src/app/shared"],
      "@shared/*": ["./src/app/shared/*"],
      "@layouts": ["./src/app/layouts"],
      "@layouts/*": ["./src/app/layouts/*"],
      "@features": ["./src/app/features"],
      "@features/*": ["./src/app/features/*"],
      "@env": ["./src/environments"],
      "@env/*": ["./src/environments/*"],
      "@shared/ui/button": ["./src/app/shared/ui/button/src/index.ts"],
      "@shared/ui/utils": ["./src/app/shared/ui/utils/src/index.ts"],
      "@shared/ui/alert": ["./src/app/shared/ui/alert/src/index.ts"],
      "@shared/ui/alert-dialog": ["./src/app/shared/ui/alert-dialog/src/index.ts"],
      "@shared/ui/avatar": ["./src/app/shared/ui/avatar/src/index.ts"],
      "@shared/ui/badge": ["./src/app/shared/ui/badge/src/index.ts"],
      "@shared/ui/breadcrumb": ["./src/app/shared/ui/breadcrumb/src/index.ts"],
      "@shared/ui/button-group": ["./src/app/shared/ui/button-group/src/index.ts"],
      "@shared/ui/calendar": ["./src/app/shared/ui/calendar/src/index.ts"],
      "@shared/ui/select": ["./src/app/shared/ui/select/src/index.ts"],
      "@shared/ui/card": ["./src/app/shared/ui/card/src/index.ts"],
      "@shared/ui/checkbox": ["./src/app/shared/ui/checkbox/src/index.ts"],
      "@shared/ui/combobox": ["./src/app/shared/ui/combobox/src/index.ts"],
      "@shared/ui/input-group": ["./src/app/shared/ui/input-group/src/index.ts"],
      "@shared/ui/input": ["./src/app/shared/ui/input/src/index.ts"],
      "@shared/ui/textarea": ["./src/app/shared/ui/textarea/src/index.ts"],
      "@shared/ui/command": ["./src/app/shared/ui/command/src/index.ts"],
      "@shared/ui/dialog": ["./src/app/shared/ui/dialog/src/index.ts"],
      "@shared/ui/date-picker": ["./src/app/shared/ui/date-picker/src/index.ts"],
      "@shared/ui/popover": ["./src/app/shared/ui/popover/src/index.ts"],
      "@shared/ui/dropdown-menu": ["./src/app/shared/ui/dropdown-menu/src/index.ts"],
      "@shared/ui/empty": ["./src/app/shared/ui/empty/src/index.ts"],
      "@shared/ui/field": ["./src/app/shared/ui/field/src/index.ts"],
      "@shared/ui/label": ["./src/app/shared/ui/label/src/index.ts"],
      "@shared/ui/separator": ["./src/app/shared/ui/separator/src/index.ts"],
      "@shared/ui/input-otp": ["./src/app/shared/ui/input-otp/src/index.ts"],
      "@shared/ui/pagination": ["./src/app/shared/ui/pagination/src/index.ts"],
      "@shared/ui/progress": ["./src/app/shared/ui/progress/src/index.ts"],
      "@shared/ui/radio-group": ["./src/app/shared/ui/radio-group/src/index.ts"],
      "@shared/ui/sheet": ["./src/app/shared/ui/sheet/src/index.ts"],
      "@shared/ui/sidebar": ["./src/app/shared/ui/sidebar/src/index.ts"],
      "@shared/ui/skeleton": ["./src/app/shared/ui/skeleton/src/index.ts"],
      "@shared/ui/tooltip": ["./src/app/shared/ui/tooltip/src/index.ts"],
      "@shared/ui/sonner": ["./src/app/shared/ui/sonner/src/index.ts"],
      "@shared/ui/spinner": ["./src/app/shared/ui/spinner/src/index.ts"],
      "@shared/ui/switch": ["./src/app/shared/ui/switch/src/index.ts"],
      "@shared/ui/table": ["./src/app/shared/ui/table/src/index.ts"],
      "@shared/ui/tabs": ["./src/app/shared/ui/tabs/src/index.ts"],
      "@shared/ui/toggle-group": ["./src/app/shared/ui/toggle-group/src/index.ts"],
      "@shared/ui/toggle": ["./src/app/shared/ui/toggle/src/index.ts"],
      "@shared/ui/typography": ["./src/app/shared/ui/typography/src/index.ts"],
      "@shared/ui/message": ["./src/app/shared/ui/message/src/index.ts"],
      "@shared/ui/bubble": ["./src/app/shared/ui/bubble/src/index.ts"],
      "@shared/ui/marker": ["./src/app/shared/ui/marker/src/index.ts"],
      "@shared/ui/kbd": ["./src/app/shared/ui/kbd/src/index.ts"],
      "@shared/ui/item": ["./src/app/shared/ui/item/src/index.ts"],
      "@shared/ui/resizable": ["./src/app/shared/ui/resizable/src/index.ts"],
      "@shared/ui/collapsible": ["./src/app/shared/ui/collapsible/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true,
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "error",
        "optionalChainNotNullable": "error"
      }
    }
  },
  "include": ["src/**/*.ts", "src/app/shared/ui/**/src/**/*.ts"]
}
