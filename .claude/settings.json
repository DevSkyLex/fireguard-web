{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run format)",
      "Bash(npm run format:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm run build)",
      "Bash(npm run test:ci)",
      "Bash(npm run quality)",
      "Bash(npm run e2e:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng build:*)",
      "Bash(npx oxfmt:*)",
      "Bash(npx oxlint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"]
  },
  "enabledMcpjsonServers": ["angular", "spartan", "playwright", "context7"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "fireguard-web-lsp@fireguard": true
  }
}
