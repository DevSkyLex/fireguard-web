{
  "name": "fireguard-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf",
    "start:fr": "ng serve --configuration=fr",
    "start:es": "ng serve --configuration=es",
    "e2e:install": "playwright install",
    "e2e:test": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --project=chromium --debug",
    "e2e:report": "playwright show-report",
    "lint": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore",
    "lint:fix": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore --fix",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "quality": "npm run format:check && npm run lint && npm run test:ci && npm run build",
    "serve:ssr:fireguard-web": "node dist/fireguard-web/server/server.mjs",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.1.6",
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/localize": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-server": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "@angular/ssr": "^21.1.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/signals": "^21.0.1",
    "@signality/core": "^0.3.2",
    "@spartan-ng/brain": "^1.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.2.18",
    "@playwright/test": "1.59.1",
    "@spartan-ng/cli": "^1.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.1.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "playwright-ng-schematics": "^21.0.10",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "npm@11.4.1"
}
