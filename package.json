{
  "name": "fireguard-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration=e2e",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "i18n:extract": "ng extract-i18n --output-path src/locale --format xlf",
    "start:fr": "ng serve --configuration=fr",
    "start:es": "ng serve --configuration=es",
    "e2e:install": "playwright install",
    "e2e:test": "playwright test",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --project=chromium --debug",
    "e2e:report": "playwright show-report",
    "lint": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore",
    "lint:fix": "oxlint -c .oxlintrc.json . --tsconfig tsconfig.json --ignore-path .gitignore --fix",
    "format": "oxfmt -c .oxfmtrc.json .",
    "format:check": "oxfmt -c .oxfmtrc.json --check .",
    "quality": "npm run format:check && npm run lint && npm run test:ci && npm run build",
    "serve:ssr:fireguard-web": "node dist/fireguard-web/server/server.mjs",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/lucide": "^34.0.0",
    "@ngrx/operators": "^21.0.1",
    "@ngrx/signals": "^21.0.1",
    "@signality/core": "^0.4.0",
    "@spartan-ng/brain": "^1.3.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.4.0",
    "ng2-charts": "^10.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-server": "^22.1.2",
    "@playwright/test": "1.62.1",
    "@spartan-ng/cli": "^1.3.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.3",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright-ng-schematics": "^22.0.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "$@angular/core"
    }
  },
  "packageManager": "npm@11.4.1"
}
